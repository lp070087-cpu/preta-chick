# Modelo de configuracao. Copie para .env e preencha os valores REAIS.
# O arquivo .env nao e versionado (ver .gitignore). NUNCA coloque valores
# reais neste arquivo de exemplo nem em qualquer arquivo do repositorio.

# Conexao do Neon PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# No Neon: painel do projeto -> Connection string -> "Pooled connection".
DATABASE_URL=

# Opcional. Se ficar vazia, o ambiente e tratado como producao (cookie Secure).
# Use "development" somente ao testar em http://localhost.
NODE_ENV=

# Opcional. Prazo da sessao persistente (o "Manter conectado"), em dias.
# Se ficar vazio, o padrao e 30 dias.
SESSAO_DIAS=

# ---------------------------------------------------------------- PAINEL
# Código de uso único para criar a conta da PROPRIETÁRIA no primeiro acesso
# a /admin.html. Depois de criada a conta, pode ser removido.
ADMIN_SETUP_TOKEN=

# ---------------------------------------------------------------- FRETE
# Melhor Envio (inclui PAC/SEDEX dos Correios). Sem token, o site mostra só
# retirada na loja e entrega local a combinar.
MELHORENVIO_TOKEN=
# "sandbox" (homologação, padrão) ou "producao"
MELHORENVIO_AMBIENTE=
# e-mail técnico exigido pelo Melhor Envio no User-Agent
MELHORENVIO_CONTATO=
# opcional: ids de serviços separados por vírgula (ex.: 1,2)
MELHORENVIO_SERVICOS=
# segredo do aplicativo ME, para validar o webhook (X-ME-Signature)
MELHORENVIO_WEBHOOK_SECRET=
# CEP da loja (também editável no painel > Configurações)
FRETE_CEP_ORIGEM=

# ---------------------------------------------------------------- PAGAMENTO
# Nome da plataforma de pagamento da loja, quando o adaptador existir.
# Vazio = pagamentos registrados manualmente pela equipe no painel.
PAGAMENTO_PROVEDOR=
